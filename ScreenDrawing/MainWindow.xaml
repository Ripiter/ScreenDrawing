<Window x:Class="ScreenDrawing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenDrawing"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <InkCanvas x:Name="Ink" Background="#01000000"/>
        <Border x:Name="Toolbar" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,28" Padding="8" Background="#F01E1E1E" CornerRadius="12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CurrentColorBtn" Width="30" Height="30" MinWidth="0" Click="Pick_Click"/>
                <Border Width="1" Background="#555" Margin="6,4"/>
                <Button x:Name="R0" Width="22" Height="22" MinWidth="0" Visibility="Collapsed" Click="Recent_Click"/>
                <Button x:Name="R1" Width="22" Height="22" MinWidth="0" Visibility="Collapsed" Click="Recent_Click"/>
                <Button x:Name="R2" Width="22" Height="22" MinWidth="0" Visibility="Collapsed" Click="Recent_Click"/>
                <Button x:Name="R3" Width="22" Height="22" MinWidth="0" Visibility="Collapsed" Click="Recent_Click"/>
                <Button x:Name="R4" Width="22" Height="22" MinWidth="0" Visibility="Collapsed" Click="Recent_Click"/>
                <Border Width="1" Background="#555" Margin="6,4"/>
                <Button Content="S" Tag="3"  Click="Size_Click"/>
                <Button Content="M" Tag="6"  Click="Size_Click"/>
                <Button Content="L" Tag="12" Click="Size_Click"/>
                <TextBox x:Name="SizeBox" Width="52" Height="34" Margin="3"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         Background="#3A3A3A" Foreground="White" BorderThickness="0"
                         FontSize="14" Text="6" TextChanged="SizeBox_TextChanged"/>
                <TextBlock Text="px" Foreground="#AAA" VerticalAlignment="Center" Margin="1,0,6,0"/>
                <Border Width="1" Background="#555" Margin="6,4"/>
                <Button Content="Pen"   Click="Pen_Click"/>
                <Button Content="Erase" Click="Erase_Click"/>
                <Button Content="Clear" Click="Clear_Click"/>
                <Button Content="Exit"  Click="Exit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
